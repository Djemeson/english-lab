rules_version = '2';

// ================================================================
// REGRAS DO FIRESTORE — o acervo, os cards, os livros
// ================================================================
// Cópia fiel do que está publicado, trazida para o repositório em 2026-08-21
// pelo mesmo motivo do `storage.rules`: regra que só existe no console é regra
// que ninguém confere. Não é uma mudança — é o que já estava no ar.
//
// Publicar:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    // ⚠️ TRAVADO NA CONTA DO DONO (rodada 44). O app é público (Pages/Vercel)
    // e a config do Firebase é visível por natureza: sem esta linha, QUALQUER
    // conta Google do planeta podia logar, ganhar uma pasta própria e comer a
    // cota gratuita do projeto. App de uma pessoa, regra de uma pessoa.
    function ehODono() {
      return request.auth != null && request.auth.token.email == 'djemesongentedigital@gmail.com';
    }
    // Cada pessoa na própria pasta, e nada além.
    match /users/{userId}/{document=**} {
      allow read, write: if ehODono() && request.auth.uid == userId;
    }
  }
}

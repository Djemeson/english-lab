rules_version = '2';

// ================================================================
// REGRAS DO FIRESTORE — o acervo, os cards, os livros
// ================================================================
// Cópia fiel do que está publicado, trazida para o repositório em 2026-08-21
// pelo mesmo motivo do `storage.rules`: regra que só existe no console é regra
// que ninguém confere. Não é uma mudança — é o que já estava no ar.
//
// Publicar:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa na própria pasta, e nada além.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

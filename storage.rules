rules_version = '2';

// ================================================================
// REGRAS DO STORAGE — quem pode ler e gravar cada arquivo
// ================================================================
// ⚠️ ESTE ARQUIVO PASSOU A EXISTIR EM 2026-08-21, E O MOTIVO IMPORTA. Até
// aqui as regras viviam SÓ no console do Firebase, e ninguém sabia o que
// estava no ar sem abrir o navegador. O preço apareceu na mesma rodada: o
// ESTADO-DO-PROJETO documentava um teto de 50 MB, o console tinha 500 MB, e
// eu recomendei ao usuário uma mudança que já estava feita. Regra que não
// está no repositório é regra que ninguém confere.
//
// Publicar:  firebase deploy --only storage
//
// O DESENHO É SEMPRE O MESMO: cada pessoa enxerga a própria pasta e nada
// além. `request.auth.uid == uid` é o que garante isso — o caminho carrega o
// dono, e o servidor confere. O que muda de bloco para bloco é só o TETO DE
// TAMANHO, e ele existe para que um erro (ou um abuso) não encha a cota de
// 5 GB do plano gratuito de uma vez.

service firebase.storage {
  match /b/{bucket}/o {

    // ⚠️ TRAVADO NA CONTA DO DONO (rodada 44) — mesmo motivo do Firestore:
    // qualquer conta Google podia logar e subir 2 GB por arquivo até estourar
    // a cota. App de uma pessoa, regra de uma pessoa.
    function ehODono() {
      return request.auth != null && request.auth.token.email == 'djemesongentedigital@gmail.com';
    }

    // ---- O ÁUDIO DO AUDIOLIVRO ----
    // Faixa própria porque a escala é outra: um EPUB tem 4 MB, um episódio de
    // vídeo algumas centenas — um `.m4b` de audiolivro vai de 100 MB a mais de
    // 1 GB (24 horas de narração a 128 kbps passam de 1,3 GB). Com o teto
    // comum, "Guardar na nuvem" morria num `unauthorized` seco, que é a mesma
    // palavra de quem nem está logado.
    //
    // ⚠️ As regras do Storage são UNIÃO, não precedência: este arquivo casa
    // também com o bloco genérico abaixo, e basta um dos dois permitir. É por
    // isso que a ordem aqui não importa — e é por isso que o bloco de baixo
    // NÃO precisa abrir exceção nenhuma.
    match /users/{uid}/audiolivros/{allPaths=**} {
      allow read:           if ehODono() && request.auth.uid == uid;
      allow create, update: if ehODono() && request.auth.uid == uid
                            && request.resource.size < 2147483648;   // 2 GB
      allow delete:         if ehODono() && request.auth.uid == uid;
    }

    // ---- TODO O RESTO ----
    // EPUB do leitor, episódio de vídeo, legenda, capa. 500 MB cobre com folga
    // e continua sendo um freio de verdade.
    match /users/{uid}/{allPaths=**} {
      allow read:           if ehODono() && request.auth.uid == uid;
      allow create, update: if ehODono() && request.auth.uid == uid
                            && request.resource.size < 524288000;    // 500 MB
      allow delete:         if ehODono() && request.auth.uid == uid;
    }
  }
}

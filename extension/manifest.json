{
  "manifest_version": 3,
  "name": "Language Lab — Netflix e Kindle",
  "version": "3.17.0",
  "description": "Captura vocabulário para o Language Lab direto da Netflix (legendas clicáveis, tradução por IA, transcript) e do Kindle Cloud Reader (palavra selecionada + a frase da página).",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://djemeson.github.io/*",
    "https://*.vercel.app/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "netflix.js"
      ],
      "css": [
        "netflix.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://read.amazon.com/*",
        "https://read.amazon.com.br/*",
        "https://read.amazon.co.uk/*"
      ],
      "js": [
        "kindle.js"
      ],
      "css": [
        "kindle.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://djemeson.github.io/*",
        "https://*.vercel.app/*",
        "http://localhost:8765/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Language Lab — capturas da Netflix e do Kindle"
  }
}
